generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum ProductType {
  HT
  HK
}

enum UserRole {
  ADMIN
  USER
}

enum TransactionType {
  INCOMING
  OUTGOING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  DEACTIVATE
  ACTIVATE
  INITIAL_STOCK_CHANGE
}

// ==========================================
// USER
// ==========================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)

  incomingTransactions  Incoming[] @relation("IncomingResponsible")
  outgoingTransactions Outgoing[] @relation("OutgoingResponsible")

  auditLogs AuditLog[] @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
  @@map("users")
}

// ==========================================
// PRODUCT MASTER
// ==========================================

model Product {
  id           String      @id @default(cuid())
  type         ProductType
  computerCode String
  partNo       String
  productName  String

  // Initial Stock dalam PCS
  initialStock Int @default(0)

  // Product status
  isActive Boolean @default(true)

  // Relations
  incomingTransactions Incoming[]
  outgoingTransactions Outgoing[]

  auditLogs AuditLog[] @relation("ProductAuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Computer Code boleh sama antara HT dan HK,
  // tetapi tidak boleh duplikat dalam tipe yang sama.
  @@unique([type, computerCode])
  @@index([computerCode])
  @@index([partNo])
  @@index([productName])
  @@index([type, isActive])
  @@map("products")
}

// ==========================================
// INCOMING TRANSACTION
// ==========================================

model Incoming {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int

  responsibleId String
  responsible   User   @relation("IncomingResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)

  remark String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, date])
  @@index([responsibleId])
  @@index([date])
  @@map("incoming")
}

// ==========================================
// OUTGOING TRANSACTION
// ==========================================

model Outgoing {
  id   String   @id @default(cuid())
  date DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantityOut Int @default(0)
  ng          Int @default(0)
  spare       Int @default(0)

  responsibleId String
  responsible   User   @relation("OutgoingResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)

  remark String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, date])
  @@index([responsibleId])
  @@index([date])
  @@map("outgoing")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id String @id @default(cuid())

  action AuditAction

  productId String?
  product   Product? @relation("ProductAuditLogs", fields: [productId], references: [id], onDelete: SetNull)

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String?

  oldData Json?
  newData Json?

  description String? @db.Text

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
